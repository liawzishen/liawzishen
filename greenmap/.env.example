,# ── Public (safe in the browser) ─────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Used later for QR links (Phase 7). Localhost is fine for now.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server-only (NEVER expose in the browser) ────────────────────────────────
# Needed from Phase 2/5 onward (seed script + API routes). Leave blank for Phase 1.
SUPABASE_SERVICE_ROLE_KEY=
# Needed in Phase 6 (Gemini Vision/Text). Without it, scans return a clearly
# labelled sample result so the flow still works. Get a free key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the Gemini model used for scans + suggestions.
# Default is gemini-2.0-flash.
GEMINI_MODEL=
# Live satellite search in farm setup (server-only; never exposed to the browser).
# Free MapTiler key (no credit card) at https://cloud.maptiler.com/account/keys/.
# Without it, the "Satellite" option falls back to the smart background.
MAPTILER_API_KEY=
